fn greet(name) {
    print "Hello " + name;
}

struct Vehicle {
    drive() {
        print "Vehicle is driving";
    }
}

struct Car {
    init(speed) {
        self.speed = speed;
    }

    drive() {
        print "Car is driving " + self.speed + " km per hour";
    }
}

fn main() {
    greet("Piotr");
    let v = Vehicle();
    let c = Car(10);
    v.drive();
    c.drive();
    print "Bye!";
}

main();